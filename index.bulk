{"body": "Baltimore City Code Chapter 37 [Vacant]", "num": "37", "path": "library|City of Baltimore, Md., Code|building-codes|II|37", "title": "Chapter 37 [Vacant]", "url": "/us/md/cities/baltimore/code/building-codes/II/37"}
