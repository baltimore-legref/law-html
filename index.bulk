{"body": "Baltimore City Code Chapter 2 Definitions; Rules of Construction Section 201. General Section 202. Definitions", "num": "2", "path": "library|City of Baltimore, Md., Code|building-codes|II|2", "title": "Chapter 2 Definitions; Rules of Construction", "url": "/us/md/cities/baltimore/code/building-codes/II/2"}
